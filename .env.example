# Flask
FLASK_SECRET_KEY=your-32-byte-hex-string-here
FLASK_DEBUG=false

# Encryption for DB-stored OAuth tokens (REQUIRED)
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Canvas OAuth (fill when you have Developer Key from Canvas admin)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_BASE_URL=https://lms.vinschool.edu.vn

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Legacy PAT fallback (optional, for backward compatibility)
API_TOKEN=

# Admin API key for feedback endpoints
ADMIN_API_KEY=