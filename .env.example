# Flask
FLASK_DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Legacy PAT fallback (optional, for backward compatibility)
API_TOKEN=

# Admin API key for feedback endpoints
ADMIN_API_KEY=

# Optional: route VSC timetable tool requests through a Cloudflare Worker relay.
# See worker/README.md. Canvas requests stay direct.
TIMETABLE_RELAY_URL=
TIMETABLE_RELAY_KEY=

# Optional: run a local relay instead of the Worker. See LOCAL_RELAY.md.
# These are read by local_relay.py, not by the Flask app.
# RELAY_KEY=
# RELAY_PORT=8787

# Optional: route VSC timetable tool requests through an HTTP proxy (experiment).
# Prefer TIMETABLE_RELAY_URL when both are set.
TIMETABLE_PROXY_URL=
